<?xml version="1.0" encoding="utf-8"?><!--
   Nothing leaves the device. The app holds a live Telegram session and the
   wrapped encryption key, so a restored copy on another device would be a
   working account and, with the passphrase, readable data.

   On Android 12 and higher android:allowBackup only governs cloud backup;
   device-to-device transfer is controlled here, so both are opted out.

   Losing this data costs nothing: signing in again rebuilds the index from
   the storage channel, which is the source of truth.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>