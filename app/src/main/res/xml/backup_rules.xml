<?xml version="1.0" encoding="utf-8"?><!--
   Backup is disabled outright, but Android 11 and lower read this file if the
   flag is ever turned on. It excludes the same session and key material that
   data_extraction_rules.xml covers on Android 12 and higher.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>